    "frames": {
      "platforms": ["js", "dart", "kotlin"],
      "cases": [
        { "id": "frames_basic_5b_chunk4", "payloadHex": "0102030405", "chunkSize": 4, "expect": { "ok": true, "frames": ["00020401020304", "01020105"] } },
        { "id": "frames_exact_multiple_8b_chunk4", "payloadHex": "0001020304050607", "chunkSize": 4, "expect": { "ok": true, "frames": ["00020400010203", "01020404050607"] } },
        { "id": "frames_single_chunk_gt_payload", "payloadHex": "aabbcc", "chunkSize": 128, "expect": { "ok": true, "frames": ["000103aabbcc"] } },
        { "id": "frames_chunk_capped_to_128", "payloadHex": "aabbcc", "chunkSize": 500, "expect": { "ok": true, "frames": ["000103aabbcc"] } },
        { "id": "frames_empty_throws", "payloadHex": "", "chunkSize": 4, "expect": { "ok": false, "throws": true } },
        { "id": "frames_over_assembly_max_throws", "fill": { "byte": "ab", "length": 1025 }, "chunkSize": 128, "expect": { "ok": false, "throws": true } },
        { "id": "frames_over_max_frames_throws", "fill": { "byte": "cd", "length": 65 }, "chunkSize": 1, "expect": { "ok": false, "throws": true } }
