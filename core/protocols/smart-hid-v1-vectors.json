  "source": {
    "contract": "smart-hid-workspace protocols/contracts/smart-hid-v1.json（SHA-256 由 core/protocols/smart-hid-contract.lock.json 锁定）",
    "canon": "Smart-HID-Workspace protocols/ble/PROVISIONING_V1.md",
    "note": "本文件是跨语言可执行测试向量单源：JS/Dart/Kotlin（及 Mac 阶段 Swift）必须消费同一组向量。scripts/check-smart-hid-contract.mjs 校验本文件常量与正典契约一致；scripts/check-platform-parity.mjs 执行各平台实现。"
  },
  "constants": {
    "serviceUuid": "9f1d1001-e73b-4c8f-9d2a-6f0b5e8a1c04",
    "characteristicUuids": {
      "info": "9f1d1002-e73b-4c8f-9d2a-6f0b5e8a1c04",
      "input": "9f1d1003-e73b-4c8f-9d2a-6f0b5e8a1c04",
      "status": "9f1d1004-e73b-4c8f-9d2a-6f0b5e8a1c04"
    },
    "namePrefix": "SHID-",
    "protocolVersion": "1.0",
    "candidateVersion": 1,
    "deviceIdPattern": "^HID-[A-Z0-9]{8}$",
    "deviceNamePattern": "^SHID-[A-Z0-9]{6,8}$",
    "tokenPattern": "^[0-9a-f]{32}$",
    "qrScheme": "shid://pair",
    "defaultPairingPort": 17892,
    "frame": {
      "headerSize": 3,
      "maxChunkBytes": 128,
      "maxAssembledBytes": 1024,
      "maxFrames": 64,
      "defaultAttMtu": 23
    },
    "states": ["boot", "load_config", "unprovisioned", "provisioning", "connecting_wifi", "pairing", "mqtt_connecting", "ready", "recovery", "error"],
    "steps": ["received", "connecting_wifi", "wifi_connected", "pairing", "pairing_success", "mqtt_connecting", "ready"],
    "errorCodes": ["invalid_payload", "wifi_failed", "controlhub_unreachable", "pairing_invalid", "pairing_expired", "pairing_used", "mqtt_invalid", "storage_failed"],
    "errorHints": {
      "invalid_payload": "配置内容非法，请检查输入",
      "wifi_failed": "Wi-Fi 连接失败，请检查 SSID / 密码",
      "controlhub_unreachable": "连不上 ControlHub，请确认它在运行、地址可达",
      "pairing_invalid": "配对码无效，请重新扫码",
      "pairing_expired": "配对码已过期，请重新扫码",
      "pairing_used": "配对码已被使用，请重新扫码",
      "mqtt_invalid": "MQTT 连接失败，请进入诊断",
      "storage_failed": "设备存储失败，请重试或联系支持"
    }
  },
  "suites": {
    "qr": {
      "platforms": ["js", "dart", "kotlin"],
      "cases": [
        { "id": "qr_ok_full", "input": "shid://pair?token=0123456789abcdef0123456789abcdef&host=192.168.1.10&port=17892", "expect": { "ok": true, "token": "0123456789abcdef0123456789abcdef", "host": "192.168.1.10", "port": 17892 } },
        { "id": "qr_ok_default_port", "input": "shid://pair?token=0123456789abcdef0123456789abcdef&host=hub.lan", "expect": { "ok": true, "token": "0123456789abcdef0123456789abcdef", "host": "hub.lan", "port": 17892 } },
        { "id": "qr_ok_uppercase_token_normalized", "input": "shid://pair?token=0123456789ABCDEF0123456789ABCDEF&host=192.168.1.10", "expect": { "ok": true, "token": "0123456789abcdef0123456789abcdef", "host": "192.168.1.10", "port": 17892 } },
        { "id": "qr_bad_token_short", "input": "shid://pair?token=0123456789abcdef0123456789abcde&host=192.168.1.10", "expect": { "ok": false } },
        { "id": "qr_bad_token_nonhex", "input": "shid://pair?token=0123456789abcdef0123456789abcdeg&host=192.168.1.10", "expect": { "ok": false } },
        { "id": "qr_bad_scheme", "input": "https://pair?token=0123456789abcdef0123456789abcdef&host=192.168.1.10", "expect": { "ok": false } },
        { "id": "qr_missing_host", "input": "shid://pair?token=0123456789abcdef0123456789abcdef", "expect": { "ok": false } },
        { "id": "qr_host_with_space", "input": "shid://pair?token=0123456789abcdef0123456789abcdef&host=192.168.1.1%20x", "expect": { "ok": false } },
        { "id": "qr_bad_port_range", "input": "shid://pair?token=0123456789abcdef0123456789abcdef&host=192.168.1.10&port=70000", "expect": { "ok": false } },
        { "id": "qr_duplicate_param", "input": "shid://pair?token=0123456789abcdef0123456789abcdef&token=0123456789abcdef0123456789abcdef&host=192.168.1.10", "expect": { "ok": false } }
      ]
    },
    "candidate": {
      "platforms": ["js", "dart", "kotlin"],
      "cases": [
        { "id": "cand_ok_full", "input": { "wifi_ssid": "Home-2.4G", "wifi_password": "p@ss w0rd", "hub_host": "192.168.1.10", "hub_port": 17892, "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": true, "json": "{\"v\":1,\"wifi_ssid\":\"Home-2.4G\",\"wifi_password\":\"p@ss w0rd\",\"hub_host\":\"192.168.1.10\",\"hub_port\":17892,\"token\":\"0123456789abcdef0123456789abcdef\"}" } },
        { "id": "cand_ok_default_port", "input": { "wifi_ssid": "Home", "wifi_password": "pw", "hub_host": "hub.lan", "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": true, "json": "{\"v\":1,\"wifi_ssid\":\"Home\",\"wifi_password\":\"pw\",\"hub_host\":\"hub.lan\",\"hub_port\":17892,\"token\":\"0123456789abcdef0123456789abcdef\"}" } },
        { "id": "cand_ok_trim", "input": { "wifi_ssid": "  Home  ", "wifi_password": "pw", "hub_host": " 192.168.1.10 ", "token": " 0123456789abcdef0123456789abcdef " }, "expect": { "ok": true, "json": "{\"v\":1,\"wifi_ssid\":\"Home\",\"wifi_password\":\"pw\",\"hub_host\":\"192.168.1.10\",\"hub_port\":17892,\"token\":\"0123456789abcdef0123456789abcdef\"}" } },
        { "id": "cand_bad_ssid_empty", "input": { "wifi_ssid": "", "wifi_password": "pw", "hub_host": "hub.lan", "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": false, "throws": true } },
        { "id": "cand_bad_ssid_long", "input": { "wifi_ssid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "wifi_password": "pw", "hub_host": "hub.lan", "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": false, "throws": true } },
        { "id": "cand_bad_password_long", "input": { "wifi_ssid": "Home", "wifi_password": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "hub_host": "hub.lan", "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": false, "throws": true } },
        { "id": "cand_bad_host_empty", "input": { "wifi_ssid": "Home", "wifi_password": "pw", "hub_host": "", "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": false, "throws": true } },
        { "id": "cand_bad_token", "input": { "wifi_ssid": "Home", "wifi_password": "pw", "hub_host": "hub.lan", "token": "not-a-token" }, "expect": { "ok": false, "throws": true } },
        { "id": "cand_bad_port_zero", "input": { "wifi_ssid": "Home", "wifi_password": "pw", "hub_host": "hub.lan", "hub_port": 0, "token": "0123456789abcdef0123456789abcdef" }, "expect": { "ok": false, "throws": true } }
      ]
    },
