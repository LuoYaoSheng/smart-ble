        { "id": "rec_pairing_invalid", "code": "pairing_invalid", "expect": "pairing" },
        { "id": "rec_pairing_expired", "code": "pairing_expired", "expect": "pairing" },
        { "id": "rec_pairing_used", "code": "pairing_used", "expect": "pairing" },
        { "id": "rec_mqtt_invalid", "code": "mqtt_invalid", "expect": "diagnostics" },
