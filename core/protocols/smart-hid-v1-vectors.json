    "deviceInfo": {
      "platforms": ["js", "dart", "kotlin"],
      "cases": [
        { "id": "info_ok_full", "input": "{\"product\":\"smart-hid\",\"protocol\":\"1.0\",\"device_id\":\"HID-ABCD1234\",\"firmware\":\"1.1.0\",\"state\":\"unprovisioned\",\"provisioned\":false}", "expect": { "ok": true, "product": "smart-hid", "protocol": "1.0", "device_id": "HID-ABCD1234", "firmware": "1.1.0", "state": "unprovisioned", "provisioned": false } },
        { "id": "info_ok_minimal_fields_defaulted", "input": "{\"device_id\":\"HID-00000001\"}", "expect": { "ok": true, "product": "", "protocol": "", "device_id": "HID-00000001", "firmware": "", "state": "", "provisioned": false } },
        { "id": "info_bad_json", "input": "{oops", "expect": { "ok": false } },
        { "id": "info_missing_device_id", "input": "{\"product\":\"smart-hid\"}", "expect": { "ok": false } },
        { "id": "info_non_object", "input": "[1,2]", "expect": { "ok": false } }
