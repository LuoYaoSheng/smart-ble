    "status": {
      "platforms": ["js", "dart", "kotlin"],
      "cases": [
        { "id": "status_ok_progress", "input": "{\"state\":\"provisioning\",\"step\":\"connecting_wifi\",\"error\":null}", "expect": { "ok": true, "state": "provisioning", "step": "connecting_wifi", "error": null } },
        { "id": "status_ok_error_passthrough", "input": "{\"state\":\"error\",\"step\":\"\",\"error\":\"wifi_failed\"}", "expect": { "ok": true, "state": "error", "step": "", "error": "wifi_failed" } },
        { "id": "status_bad_json", "input": "not-json", "expect": { "ok": false } },
        { "id": "status_missing_fields_defaulted", "input": "{}", "expect": { "ok": true, "state": "", "step": "", "error": null } }
