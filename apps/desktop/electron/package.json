{
  "name": "smart-ble-desktop",
  "version": "1.0.5",
  "description": "Smart BLE - Desktop Application",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "ble",
    "bluetooth",
    "electron"
  ],
  "author": "SmartBLE",
  "license": "MIT",
  "dependencies": {
    "@abandonware/noble": "^1.9.2-15"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "encoding": "0.1.13",
    "node-gyp": "12.4.0"
  },
  "build": {
    "appId": "com.smartble.electron",
    "productName": "BLE Toolkit+",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "!**/node_modules/**/build/**/*.d",
      "!**/node_modules/**/build/**/*.o",
      "!**/node_modules/**/build/**/*.a",
      "!**/node_modules/**/build/**/*.mk",
      "!**/node_modules/**/build/**/Makefile",
      "!**/node_modules/**/build/**/*.gypi",
      "!**/node_modules/**/build/**/obj.target/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "用于扫描、连接和调试附近的 BLE 设备。",
        "NSCameraUsageDescription": "用于扫描 ControlHub 配对二维码，不保存图像。"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "smart-ble-open"
    },
    "nativeRebuilder": "sequential",
    "artifactName": "Smart-BLE-Open-${version}-${os}-${arch}.${ext}"
  },
  "overrides": {
    "@abandonware/bluetooth-hci-socket": "npm:@stoprocent/bluetooth-hci-socket@2.3.0",
    "node-gyp": "12.4.0"
  }
}
