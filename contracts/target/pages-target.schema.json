{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-ble.local/contracts/target/pages-target.schema.json",
  "title": "Smart BLE target pages contract",
  "type": "object",
  "required": ["schema_version", "product_version", "status", "last_approved_at", "approved_by", "pages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "product_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "SUPERSEDED"] },
    "last_approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"] },
    "pages": {
      "type": "array", "minItems": 11, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name", "route", "type", "template_sections", "operations", "states", "entry_from", "exit_to", "planned_tests", "minimum_evidence_level", "release_blocking"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(PAGE-[0-9]{3}|WEB-001)$" },
          "name": { "type": "string" },
          "route": { "type": "string", "pattern": "^(pages/[a-z/]+|/)$" },
          "type": { "enum": ["tab", "secondary", "web"] },
          "template_sections": { "type": "integer", "minimum": 24, "maximum": 24 },
          "required_params": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "optional_params": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "forbidden_params": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "operations": { "type": "array", "items": { "type": "string", "pattern": "^OP-(P[0-9]{3}|W001)-[0-9]{2}$" }, "minItems": 1, "uniqueItems": true },
          "deprecated_operations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "states": { "type": "array", "items": { "type": "string", "pattern": "^STATE-(P[0-9]{3}|W001)-[0-9]{2}$" }, "minItems": 1, "uniqueItems": true },
          "entry_from": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "exit_to": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "planned_tests": { "type": "array", "items": { "type": "string", "pattern": "^TEST-[CUPIEAWHR]-[0-9]{3}$" }, "minItems": 1, "uniqueItems": true },
          "minimum_evidence_level": { "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"] },
          "release_blocking": { "type": "boolean" }
        }
      }
    }
  }
}
