{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-ble.local/contracts/target/test-traceability.schema.json",
  "title": "Smart BLE planned test traceability contract",
  "type": "object",
  "required": ["schema_version", "product_version", "status", "last_approved_at", "approved_by", "planned_only", "suites", "tests", "coverage"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "product_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "SUPERSEDED"] },
    "last_approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"] },
    "planned_only": { "const": true },
    "note": { "type": "string" },
    "suites": {
      "type": "array", "minItems": 9, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["prefix", "level", "count"],
        "additionalProperties": false,
        "properties": {
          "prefix": { "type": "string", "pattern": "^TEST-[CUPIEAWHR]-$" },
          "level": { "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"] },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tests": {
      "type": "array", "minItems": 103, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "evidence_level", "release_blocking", "requirements", "features", "pages_or_flows", "claims", "implemented"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^TEST-[CUPIEAWHR]-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 2 },
          "evidence_level": { "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"] },
          "release_blocking": { "type": "boolean" },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }, "uniqueItems": true },
          "features": { "type": "array", "items": { "type": "string", "pattern": "^FEAT-[0-9]{3}$" }, "uniqueItems": true },
          "pages_or_flows": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "claims": { "type": "array", "items": { "type": "string", "pattern": "^CLAIM-[0-9]{3}$" }, "uniqueItems": true },
          "implemented": { "const": false }
        }
      }
    },
    "coverage": {
      "type": "object", "required": ["requirements_total", "requirements_with_automation", "must_features_total"],
      "additionalProperties": false,
      "properties": {
        "requirements_total": { "type": "integer", "minimum": 66 },
        "requirements_with_automation": { "type": "integer", "minimum": 66 },
        "must_features_total": { "type": "integer", "minimum": 75 }
      }
    }
  }
}
