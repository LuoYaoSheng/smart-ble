{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-ble.local/contracts/target/platform-target.schema.json",
  "title": "Smart BLE target platform capability matrix",
  "type": "object",
  "required": ["schema_version", "product_version", "status", "last_approved_at", "approved_by", "platforms", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "product_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "SUPERSEDED"] },
    "last_approved_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "type": ["string", "null"] },
    "platforms": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["id", "name", "role", "public_status_target"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["android-app", "wechat-miniprogram", "h5", "ios-app"] },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "public_status_target": { "enum": ["VERIFIED", "PREVIEW", "BLOCKED", "UNSUPPORTED", "NOT_RELEASED"] },
          "note": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array", "minItems": 28, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name", "android_app", "wechat", "h5", "ios_app"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[0-9]{2}$" },
          "name": { "type": "string" },
          "android_app": { "enum": ["Full", "Adapted", "Degraded", "Unsupported", "Not Released", "N/A"] },
          "wechat": { "enum": ["Full", "Adapted", "Degraded", "Unsupported", "Not Released", "N/A"] },
          "h5": { "enum": ["Full", "Adapted", "Degraded", "Unsupported", "Not Released", "N/A"] },
          "ios_app": { "enum": ["Full", "Adapted", "Degraded", "Unsupported", "Not Released", "N/A"] },
          "degradation_ui": { "type": "string" }
        }
      }
    }
  }
}
